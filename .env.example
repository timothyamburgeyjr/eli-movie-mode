PLEX_URL=https://pixel-direct.usbx.me:14975
PLEX_TOKEN=your-plex-token
GEMINI_API_KEY=your-gemini-api-key
KINDROID_API_KEY=your-kindroid-api-key
KINDROID_AI_ID=your-kindroid-ai-id
SECRET_KEY=generate-a-random-string

# Where per-session journal files get written.
#   Local dev (Windows):  D:\Vault
#   Docker:               /journals   (bind-mount D:/Vault → /journals in docker-compose)
JOURNAL_DIR=D:\Vault
